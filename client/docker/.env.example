# 固定版本；升级前核对 Headscale 兼容性。
TAILSCALE_VERSION=v1.104
TS_HOSTNAME=linux-router
# 必改：Headscale 预认证密钥，不是 Headplane 登录用的 API Key。
TS_AUTHKEY=
# 按需改：发布本机可达的内网，多个网段用逗号分隔；不发布时留空。
TS_ROUTES=172.16.0.0/24
# 必改/核对：控制域名；按需删除 --advertise-exit-node。
TS_EXTRA_ARGS=--login-server=https://hb.sxxpqp.top --accept-routes --advertise-exit-node
