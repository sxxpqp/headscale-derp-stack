# client/k8s 专用变量；复制为本目录 setup.env 后修改。
# KEY=value，不加引号、不写 export；无需 ROLE 或 MODE。
# 输出实例名（不改变实际 namespace / Compose 项目名）
INSTANCE=prod
# 公网 HTTPS URL，可带 :8443
PUBLIC_URL=https://hs.wishfoxs.com:5443
# 留空使用集群默认 StorageClass
STORAGE_CLASS=
# 唯一的客户端节点名称
CLIENT_NAME=site-a-router
# Headplane 创建的客户端 Pre-Auth Key，不是管理 API Key
AUTH_KEY=
# 规范 IPv4 CIDR，逗号分隔；留空不发布
ROUTES=192.168.150.0/24,10.96.0.0/12,172.16.0.0/16
# y/n：接受其他节点子网路由
ACCEPT_ROUTES=n
# y/n：提供互联网出口
EXIT_NODE=n
