# server/k8s 专用变量；复制为本目录 setup.env 后修改。
# KEY=value，不加引号、不写 export；无需 ROLE 或 MODE。
# 输出实例名（不改变实际 namespace / Compose 项目名）
INSTANCE=prod
# 公网 HTTPS URL，可带 :8443
PUBLIC_URL=https://hb.sxxpqp.top
# 服务端真实公网 IPv4，必须替换
PUBLIC_IPV4=undefined
# MagicDNS 基域，不用 .local
MAGIC_DOMAIN=ts.corp.internal
# 留空自动生成；已有部署填写原32字符会话密钥
COOKIE_SECRET=
# 固定 STUN / 路由节点 hostname，必须替换
NODE=REPLACE_WITH_NODE
# 留空使用集群默认 StorageClass
STORAGE_CLASS=
# 已有 IngressClass，必须替换
INGRESS_CLASS=REPLACE_WITH_INGRESS_CLASS
# 已有或待导入的 TLS Secret 名称
TLS_SECRET=headscale-tls
# n=使用已有 Secret/cert-manager；y=本地证书生成 Secret YAML
TLS_IMPORT=n
# 证书绝对路径；Docker 留空使用默认域名路径
TLS_CERT=
# 私钥绝对路径；Docker 留空使用默认域名路径
TLS_KEY=
