# server/docker 专用变量；复制为本目录 setup.env 后修改。
# KEY=value，不加引号、不写 export；无需 ROLE 或 MODE。
# 输出实例名（不改变实际 namespace / Compose 项目名）
INSTANCE=prod
# 公网 HTTPS URL，可带 :8443
PUBLIC_URL=https://hs.wishfoxs.com:5443
# 独立管理域名，不包含 /admin；证书需同时覆盖控制和管理域名
ADMIN_URL=https://admin.wishfoxs.com:5443
# 服务端真实公网 IPv4，必须填写；不能是域名，动态 IP 需改用固定公网 IP
PUBLIC_IPV4=
# MagicDNS 基域，不用 .local
MAGIC_DOMAIN=ts.corp.internal
# 留空自动生成；已有部署填写原32字符会话密钥
COOKIE_SECRET=
# 证书绝对路径；Docker 留空使用默认域名路径
TLS_CERT=
# 私钥绝对路径；Docker 留空使用默认域名路径
TLS_KEY=