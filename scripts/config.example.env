# 非交互变量文件：KEY=value，不加引号、不使用 export 或变量展开。
# 复制到仓库根目录 setup.env 后修改。不要提交真实密钥。
ROLE=server
MODE=k8s
INSTANCE=prod

# 公网 HTTPS URL，非443端口示例：https://hb.sxxpqp.top:8443
PUBLIC_URL=https://hb.sxxpqp.top

# 服务端专用
PUBLIC_IPV4=REPLACE_WITH_PUBLIC_IPV4
MAGIC_DOMAIN=ts.corp.internal
# 留空时使用 openssl 自动生成32字符会话密钥；已有部署填写原值。
COOKIE_SECRET=

# K8s 共用：固定 STUN / 路由节点的 hostname
NODE=REPLACE_WITH_NODE
# 留空使用默认 StorageClass
STORAGE_CLASS=

# 服务端 K8s 专用
INGRESS_CLASS=REPLACE_WITH_INGRESS_CLASS
TLS_SECRET=headscale-tls
# n：使用已有 TLS Secret / cert-manager；y：从下方本地证书生成 Secret
TLS_IMPORT=n
# TLS_IMPORT=y 时必须为管理机本地可读绝对路径。
# 服务端 Docker 时表示 Nginx 所在主机的路径，留空使用域名对应的默认路径。
TLS_CERT=
TLS_KEY=

# 客户端专用：先在 Headplane 创建非 Ephemeral 的 Pre-Auth Key
CLIENT_NAME=site-a-router
AUTH_KEY=
# 只支持规范 IPv4 CIDR，逗号分隔；留空不发布子网
ROUTES=172.16.0.0/24
ACCEPT_ROUTES=y
EXIT_NODE=n
