# Docker 专用变量文件。复制到仓库根目录 setup.docker.env。
# KEY=value，不加引号，不使用 export 或变量展开。
ROLE=server
INSTANCE=prod-docker
PUBLIC_URL=https://hb.sxxpqp.top
# 服务端专用
PUBLIC_IPV4=REPLACE_WITH_PUBLIC_IPV4
MAGIC_DOMAIN=ts.corp.internal
# 留空时自动生成；已有部署填写原32字符会话密钥
COOKIE_SECRET=
# Nginx 宿主机上的证书路径；留空使用 /etc/letsencrypt/live/<域名>/ 默认路径
TLS_CERT=
TLS_KEY=
# 客户端专用：ROLE=client 时使用以下字段
CLIENT_NAME=site-a-router
AUTH_KEY=
ROUTES=172.16.0.0/24
ACCEPT_ROUTES=y
EXIT_NODE=n
